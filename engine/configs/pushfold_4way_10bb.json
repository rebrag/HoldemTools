{
  // The M8a target spot: 4 seats, blinds 1/2, 20 chips (10bb) each,
  // jam-or-fold only. Button on seat 3, so the action order is 2, 3, 0, 1
  // and seat 0 is the small blind, seat 1 the big blind.
  //
  // board_sample.iter_count is the per-iteration board sample the 3- and
  // 4-way showdowns average over; pair_count builds the pairwise matrix the
  // heads-up showdowns answer out of. Both are recorded in the artifact so a
  // result is reproducible, and the ladder that sets the default lives in
  // tools/bench_board_sample.py.
  "schema": 1,
  "game": "nlhe_preflop",
  "chip_scale": 2.0,
  "players": [
    { "seat": "SB",  "stack": 20, "range": "@file:ranges/full.txt" },
    { "seat": "BB",  "stack": 20, "range": "@file:ranges/full.txt" },
    { "seat": "CO",  "stack": 20, "range": "@file:ranges/full.txt" },
    { "seat": "BTN", "stack": 20, "range": "@file:ranges/full.txt" }
  ],
  "preflop": {
    "small_blind": 1,
    "big_blind": 2,
    "button": 3,
    "action_set": "jam_fold",
    "board_sample": { "iter_count": 500, "pair_count": 20000, "seed": 20260830 }
  },
  "algorithm": { "update": "dcfr" },
  "budget": { "iterations": 2000, "target_nashconv": 0.004, "checkpoint_every": 25 },
  "memory_limit_gb": 12,
  "threads": 0,
  "output": { "path": "out/pushfold_4way_10bb.hta", "rollups_169": true }
}
