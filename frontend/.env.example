# Template for frontend/.env - the contract, not the values.
#
# This file IS committed. It lists every variable the app reads so a fresh
# checkout (or a new git worktree) can tell at a glance what it needs.
# `scripts/ensure-env.mjs` diffs the real .env against this file and fails the
# build if a required key is missing, so keep it in sync when you add a var.
#
# The real values live OUTSIDE the repo, in one canonical file:
#   ~/.holdemtools/env/frontend.env   (override the dir with HOLDEMTOOLS_ENV_DIR)
# `npm run dev` / `npm run build` copy that file into frontend/.env for you.
# Edit the canonical file, never frontend/.env - the copy is overwritten.
#
# Convention: an uncommented key here is REQUIRED, a commented-out key is OPTIONAL.
#
# None of these are secrets in the cryptographic sense - every VITE_* value is
# inlined into the client bundle and shipped to browsers. They stay out of this
# public repo so bots trawling GitHub can't trivially point a local app at the
# real `gto-lite` Firebase project and burn its auth quota.

# Base URL of the .NET API. Azure App Service in prod; http://localhost:5182 to
# run against a local `cd backend && dotnet run`.
VITE_API_BASE_URL=

# Firebase web app config, from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration.
# Consumed by src/lib/firebase.ts. Ignored entirely when USE_FIREBASE_EMULATOR=true.
# AUTH_DOMAIN is only used off-production: on holdemtools.com the app swaps in
# its own origin as authDomain (vercel.json proxies /__/auth/* to the Firebase
# handler) so the OAuth round trip stays same-site - see lib/firebase.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_measurementId=

# Stripe price ids, matched against subscriptions by useTier / getPriceIdForTier.
# Emulator sessions use the fakes `price_pro_emulator` / `price_plus_emulator`
# instead - see "Firebase emulators" in the root CLAUDE.md.
VITE_STRIPE_PRICE_ID=
VITE_STRIPE_PRICE_ID_PLUS=
VITE_STRIPE_PRICE_ID_PRO=

# Fixed vite dev-server port (strictPort, so a clash fails loudly). Optional;
# vite.config.ts falls back to 5173 when unset - only a build/deploy host (Vercel,
# CI) never runs the dev server at all, so it never needs this var.
# This one value is per-checkout: every worktree gets the same generated .env, so
# two dev servers would collide on 5173. Override it WITHOUT touching the shared
# config by writing a per-worktree frontend/.env.local, which vite loads at higher
# precedence and ensure-env.mjs never overwrites:
#     echo "VITE_DEV_PORT=5174" > frontend/.env.local
# A shell export beats both. playwright.config.ts resolves the same value, so e2e
# targets this checkout's server rather than a neighbouring worktree's.
# VITE_DEV_PORT=5173

# Dev-only: bypass auth + tier gating (mock signed-in Pro user). Unset for prod-like builds.
# NOTE: the mock "dev-token" is not a real JWT, so it 401s against the authed postflop
# endpoints (gametree upload, library, bundles). OFF for postflop testing - sign in with
# a real account instead. Re-enable for non-postflop dev work.
# VITE_DEV_AUTH_BYPASS=true

# Tier the bypass user resolves to. Optional; defaults to pro (only matters when
# VITE_DEV_AUTH_BYPASS is on).
# VITE_DEV_TIER=pro

# Optional; defaults to off (src/lib/shareApi.ts: SHARE_ENABLED === "true").
# VITE_SHARE_ENABLED=true

# Postflop pipeline (game-tree upload + solution polling); requires the local Pio watcher running.
VITE_POSTFLOP_ENABLED=true
