# Copy to .env and fill in. .env is gitignored - never commit the connection string.

# Azure Storage (Portal > storage account > Access keys > Connection string)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=onlinerangedata

# Main loop interval (seconds): the storage-queue poll for noderequests
POLL_SECS=0.6
# Gametree claim poll (queue mode) / gametree listing (blob mode) interval.
# Slow on purpose: claim polls spend the F1 App Service CPU quota, and a
# gametree feeds a ~10-minute solve anyway.
#WATCHER_CLAIM_POLL_SECS=10
# Noderequest storage-queue push path. Unset = on; 0 = pure listing fallback.
#WATCHER_NODEREQ_QUEUE=
#WATCHER_NODEREQ_QUEUE_NAME=noderequests
# Message invisibility while a request is handled (covers the ~10-min
# cfr-evicted re-solve worst case) and the poison-queue dequeue threshold.
#WATCHER_QUEUE_VISIBILITY_SECS=900
#WATCHER_QUEUE_MAX_DEQUEUE=5
# Reconcile listing interval - the safety net behind the queue push path.
#NODEREQ_RECONCILE_SECS=45
# How long after UTC midnight to keep listing yesterday's dated directory, so
# blobs written just before the boundary are not missed.
#POLL_MIDNIGHT_GRACE_SECS=300

# PioSOLVER install
PIO_EXE=C:\PioSOLVER\PioSOLVER2-edge.exe
PIO_DIR_FOR_PYOSOLVER=C:\PioSOLVER
PIO_TREEBUILD_DIR=C:\PioSOLVER\TreeBuilding
PIO_TREE_SCRIPT_BASENAME=temp
PIO_CFR_SUBDIR=Solved
PIO_TEMP_JSON_DIR=C:\PioSOLVER\TempJson

# Solve accuracy. Solves no longer share one chip scale - a recorded hand is
# solved in its own money - so the target is normally a FRACTION OF THE POT,
# which keeps solve time about the same at any stake. 0.002 is ~1 chip on the
# 550-chip pot a typical preflop sim produces.
PIO_ACCURACY_POT_FRACTION=0.002
# Absolute fallback, in CHIPS of exploitability, used when the pot cannot be
# read from the config or PIO_ACCURACY_POT_FRACTION is set to 0.
PIO_ACCURACY=1
# Max seconds to wait for the solver to converge after 'go'
PIO_SOLVE_WAIT_SECS=900
# Max seconds to wait for the .cfr dump
PIO_CFR_WAIT_SECS=600
# Local disk budget for full .cfr saves in C:\PioSOLVER\Solved (LRU eviction)
PIO_CFR_MAX_GB=150
# Extract every turn street at solve time (~4s extra; rivers stay on-demand).
# Set to 0 to make turns on-demand too.
PIO_TURN_PRECOMPUTE=1

# PioViewer window title regex (the watcher pastes the tree config into this GUI)
PIO_TITLE_RE=(?i).*PioViewer.*

# Concurrent street-bundle uploads per publish
PIO_UPLOAD_WORKERS=8

# SolveJobs queue API. When both are set the watcher claims gametree jobs from
# the backend instead of listing ADLS blobs (noderequests stay blob-driven).
# WATCHER_API_KEY must match the API's Watcher:ApiKey setting.
HOLDEMTOOLS_API_BASE=
WATCHER_API_KEY=
# Optional overrides: WATCHER_ID defaults to the hostname; WATCHER_USE_QUEUE
# forces the mode (1 = queue, 0 = blob listing; unset = auto by config above).
#WATCHER_ID=
#WATCHER_USE_QUEUE=
# Keepalive cadence while a job is in flight (server requeues after 5 min quiet)
WATCHER_HEARTBEAT_SECS=60

# --- htsolver (engine_compare_watcher.py) ---
# Engine binary, if not at ../engine/build/engine.exe
#ENGINE_EXE=
# Hard kill for one htsolver solve, and how much of that ceiling is reserved
# for the engine to stop cleanly and write its artifact. The engine is handed
# budget.max_seconds = ceiling - margin, so a long solve is truncated and
# uploaded rather than killed and lost. Raise the ceiling for multi-hour runs.
#ENGINE_SOLVE_TIMEOUT_SECS=3600
#ENGINE_SOLVE_WRITE_MARGIN_SECS=300
# Solver checkpoints (sampled family). Set a directory to make solves
# RESUMABLE: each job continues from the checkpoint its own config identifies,
# so re-queuing the same spot with a larger budget.iterations adds iterations
# instead of restarting - which is how a solve outgrows the timeout ceiling.
# Note that re-running an identical job then becomes a no-op (already at its
# target) rather than a fresh solve. Files are small (~15 MB) but never
# cleaned up automatically.
#ENGINE_CHECKPOINT_DIR=
